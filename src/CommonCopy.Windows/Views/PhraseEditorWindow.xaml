<Window x:Class="CommonCopy.Windows.Views.PhraseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phrase"
        Width="680"
        Height="540"
        MinWidth="520"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Title" />
    <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,5,0,12" />
    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Category" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="CategoryBox" DisplayMemberPath="DisplayName" />
    </DockPanel>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="Phrase text" />
      <TextBox x:Name="TextBox"
               Grid.Row="1"
               Margin="0,5,0,10"
               AcceptsReturn="True"
               AcceptsTab="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               TextWrapping="Wrap" />
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal">
      <CheckBox x:Name="FavoriteBox" Content="Favorite" Margin="4,4,18,4" />
      <CheckBox x:Name="EnabledBox" Content="Enabled" Margin="4" IsChecked="True" />
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="CommonCopy.Windows.Views.PhrasePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommonCopy.Windows.Views"
        Title="CommonCopy"
        Width="430"
        Height="510"
        MinWidth="280"
        MinHeight="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type local:PopupNode}" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
      <Setter Property="Padding" Value="3" />
    </Style>
  </Window.Resources>

  <Border Background="#FAFBFC"
          BorderBrush="#7A838D"
          BorderThickness="1"
          CornerRadius="8"
          Padding="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Left"
                   Text="CommonCopy"
                   FontSize="17"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="4,0,10,0" />
        <TextBox x:Name="SearchBox"
                 ToolTip="Search phrases"
                 TextChanged="SearchBox_TextChanged" />
      </DockPanel>
      <TreeView x:Name="PhraseTree"
                Grid.Row="1"
                BorderThickness="0"
                Background="Transparent"
                MouseLeftButtonUp="PhraseTree_MouseLeftButtonUp" />
      <DockPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Text="Choose an action or phrase"
                   Foreground="#69737E"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="Manage phrases…" Click="Manage_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>

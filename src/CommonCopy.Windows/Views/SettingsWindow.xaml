<Window x:Class="CommonCopy.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommonCopy settings"
        Width="540"
        Height="670"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Activation" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
    <CheckBox x:Name="CtrlRightClickBox"
              Grid.Row="1"
              Content="Enable Ctrl + Right Click"
              Margin="3,4,3,9" />
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Keyboard shortcut" VerticalAlignment="Center" />
      <TextBox x:Name="ShortcutBox" Grid.Column="1" />
    </Grid>

    <TextBlock Grid.Row="3" Text="Behavior" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8" />
    <CheckBox x:Name="StartupBox"
              Grid.Row="4"
              Content="Start CommonCopy when I sign in to Windows"
              Margin="3,4" />
    <CheckBox x:Name="RestoreClipboardBox"
              Grid.Row="5"
              Content="Restore previous text clipboard content after paste"
              Margin="3,4,3,10" />

    <Grid Grid.Row="6" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Commonly Used limit" VerticalAlignment="Center" />
      <TextBox x:Name="RecentLimitBox" Grid.Column="1" />
      <TextBlock Grid.Row="1" Text="Popup width" VerticalAlignment="Center" />
      <TextBox x:Name="PopupWidthBox" Grid.Row="1" Grid.Column="1" />
      <TextBlock Grid.Row="2" Text="Paste delay (ms)" VerticalAlignment="Center" />
      <TextBox x:Name="PasteDelayBox" Grid.Row="2" Grid.Column="1" />
      <TextBlock Grid.Row="3" Text="Clipboard restore delay (ms)" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBox x:Name="ClipboardDelayBox" Grid.Row="3" Grid.Column="1" />
    </Grid>

    <CheckBox x:Name="CloseOnFocusLossBox"
              Grid.Row="7"
              Content="Close the popup when it loses focus"
              Margin="3,4" />

    <StackPanel Grid.Row="8" Margin="0,12,0,0">
      <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="LightThemeBox" GroupName="Appearance" Content="Light · Warm Editorial" Margin="4,4,22,4" />
        <RadioButton x:Name="DarkThemeBox" GroupName="Appearance" Content="Dark · Burnished Copper" Margin="4" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="9" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,12,0,8">
      <TextBlock TextWrapping="Wrap"
                 Foreground="{DynamicResource MutedBrush}"
                 Text="Shortcut format: Ctrl+Shift+Space, Alt+F2, or Win+Shift+P. If another application already owns the shortcut, Ctrl + Right Click will continue to work." />
    </Border>

    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>

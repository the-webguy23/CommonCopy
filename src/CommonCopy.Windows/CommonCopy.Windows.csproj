<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CommonCopy</AssemblyName>
    <RootNamespace>CommonCopy.Windows</RootNamespace>
    <Version>0.4.2</Version>
    <AssemblyTitle>CommonCopy</AssemblyTitle>
    <Description>Save it once. Paste it forever. Available on Windows; macOS planned.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../artifacts/branding/CommonCopy.ico')">../../artifacts/branding/CommonCopy.ico</ApplicationIcon>
    <!-- This is a WPF application that uses WinForms only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../docs/help/help.html" Link="Help/help.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="Assets/CommonCopyLogo.png" />
    <Resource Include="Assets/CommonCopyFavicon.ico" />
    <ProjectReference Include="../CommonCopy.Core/CommonCopy.Core.csproj" />
  </ItemGroup>
</Project>

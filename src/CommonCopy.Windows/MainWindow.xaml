<Window Style="{StaticResource {x:Type Window}}" x:Class="CommonCopy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommonCopy" Width="1060" Height="720" MinWidth="900" MinHeight="600"
        Icon="Assets/CommonCopyLogo.png" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,22,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
          <Border Background="White" CornerRadius="4"><Image Source="Assets/CommonCopyLogo.png" Width="38" Height="38" Stretch="Uniform" /></Border>
          <TextBlock Text="CommonCopy" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="5,0,0,11">
          <TextBlock Text="Categories" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          <Menu DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" Padding="0">
            <MenuItem Header="⋯" ToolTip="Category options">
              <MenuItem Header="Add category…" Click="AddCategory_Click" />
              <MenuItem Header="Edit category…" Click="EditCategory_Click" />
              <Separator /><MenuItem Header="Delete category…" Click="DeleteCategory_Click" />
            </MenuItem>
          </Menu>
        </DockPanel>
        <ListBox x:Name="CategoryList" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0"
                 DisplayMemberPath="DisplayName" SelectionChanged="CategoryList_SelectionChanged" />
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
          <Button Content="Open phrase menu" Click="ShowPopup_Click" Margin="0,0,0,13" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,13" />
          <Button Content="Settings" Click="Settings_Click" Margin="0,0,0,6" />
          <Menu Background="Transparent" Padding="0" HorizontalAlignment="Left">
            <MenuItem Header="Library">
              <MenuItem Header="Import library…" Click="ImportLibrary_Click" />
              <MenuItem Header="Export library…" Click="ExportLibrary_Click" />
              <Separator /><MenuItem Header="Create backup…" Click="CreateBackup_Click" />
              <MenuItem Header="Restore backup…" Click="RestoreBackup_Click" />
              <MenuItem Header="Open data folder" Click="OpenDataFolder_Click" />
              <Separator /><MenuItem Header="About CommonCopy" Click="About_Click" />
            </MenuItem>
            <MenuItem Header="Quit" Click="Exit_Click" />
          </Menu>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,26,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Your phrases" FontSize="28" FontWeight="Medium" /><TextBlock Text="Save it once. Paste it forever." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel>
        <Button Grid.Column="1" Content="Add phrase" Style="{StaticResource PrimaryButton}" Click="AddPhrase_Click" VerticalAlignment="Center" Margin="15,0,0,0" />
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,0,0,20"><TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource MutedBrush}" /><TextBox x:Name="SearchBox" ToolTip="Search phrase titles and text" AutomationProperties.Name="Search your phrases"
               TextChanged="SearchBox_TextChanged" Margin="0" /></DockPanel>
      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ElementName=CategoryList, Path=SelectedItem.DisplayName}" FontWeight="Medium" FontSize="13" />
        <TextBlock Grid.Column="1" x:Name="PhraseCountText" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="1">
        <DataGrid x:Name="PhraseGrid" BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeight="43" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  MouseDoubleClick="PhraseGrid_MouseDoubleClick" MinHeight="120">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" Header="★" Binding="{Binding IsFavorite}" Width="35" />
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" MinWidth="160" />
            <DataGridTextColumn Header="Text preview" Binding="{Binding Text}" Width="3*" MinWidth="220" />
            <DataGridTextColumn Header="Uses" Binding="{Binding UseCount}" Width="45" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="17" Margin="0,15,0,14">
        <StackPanel>
          <TextBlock Text="Selected phrase" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding ElementName=PhraseGrid, Path=SelectedItem.Title}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{Binding ElementName=PhraseGrid, Path=SelectedItem.Text}" TextWrapping="Wrap" MaxHeight="48" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,13" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="Copy" Style="{StaticResource PrimaryButton}" Click="CopyPhrase_Click" Margin="0,0,7,0" IsEnabled="{Binding ElementName=PhraseGrid, Path=SelectedItem.IsEnabled, FallbackValue=False, TargetNullValue=False}" />
            <Button Grid.Column="1" Content="Edit" Click="EditPhrase_Click" Margin="0" />
            <Menu Grid.Column="3" Background="Transparent" Padding="0" VerticalAlignment="Center">
              <MenuItem Header="⋯" ToolTip="Phrase options">
                <MenuItem Header="Add / remove Favourite" Click="ToggleFavorite_Click" />
                <MenuItem Header="Enable / disable phrase" Click="ToggleEnabled_Click" />
                <MenuItem Header="Duplicate phrase" Click="DuplicatePhrase_Click" />
                <Separator /><MenuItem Header="Move up" Click="MovePhraseUp_Click" /><MenuItem Header="Move down" Click="MovePhraseDown_Click" />
                <Separator /><MenuItem Header="Delete phrase…" Click="DeletePhrase_Click" />
              </MenuItem>
            </Menu>
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="5"><TextBlock Text="Ctrl + right-click opens your compact menu." FontSize="10" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
    </Grid>
  </Grid>
</Window>
